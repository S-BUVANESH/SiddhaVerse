{
  "name": "Nilavembu Kudineer",
  "category": "Kudineer (Decoction)",
  "ingredients": [
    "Andrographis paniculata (Nilavembu)",
    "Vetiveria zizanioides (Vettiver)",
    "Cymbopogon citratus (Inji)",
    "Santalum album (Chandanam)",
    "Trichosanthes dioica (Peipudal)"
  ],
  "method": "Boil ingredients in water, reduce to 1/8th volume, filter and consume fresh.",
  "indications": "Fevers, Dengue, Chikungunya, viral fevers",
  "dosage": "30-60 ml twice daily"
}