# SiddhaVerse Environment Template
# Copy to .env.development / .env.staging / .env.production and fill in values.
# Never commit actual .env files to version control.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
STRUCTURED_LOGGING=false

# ── Database ──────────────────────────────────────────────────────────────────
DB_TYPE=sqlite
DB_PATH=d:\Siddha_Wisdom\siddhaverse.db
# DB_TYPE=postgres
# POSTGRES_DSN=postgresql://siddha:secret@localhost:5432/siddhaverse

# ── RAG / LLM ─────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
MAX_CONTEXT_TOKENS=4000

# ── Retrieval ─────────────────────────────────────────────────────────────────
RRF_LEXICAL_WEIGHT=0.70
RRF_VECTOR_WEIGHT=0.30
ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Security ──────────────────────────────────────────────────────────────────
API_KEY_REQUIRED=false
# ALLOWED_ORIGINS=https://siddhaverse.app,https://api.siddhaverse.app
ALLOWED_ORIGINS=*
